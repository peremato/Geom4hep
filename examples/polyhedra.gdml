<?xml version="1.0"?>
<!-- \file polyhedra.gdml -->
<!-- \brief polyhedra: 18 one-sided wedges (as the CMS HCAL endcap) filling an 18-sided polyhedra, and two others -->
<!-- \license Distributed under the Apache license 2.0 -->
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <materials>
    <material Z="79" name="Gold" state="solid">
      <T unit="K" value="293.15"/>
      <D unit="g/cm3" value="19.30"/>
      <atom unit="g/mole" value="196.966570"/>
    </material>
    <material Z="0" name="Vacuum" state="gas">
      <T unit="K" value="293.15"/>
      <D unit="g/cm3" value="0.0"/>
      <atom unit="g/mole" value="0.0"/>
    </material>
    <material Z="13" name="Aluminium" state="solid">
      <T unit="K" value="293.15"/>
      <MEE unit="eV" value="166"/>
      <D unit="g/cm3" value="2.69999857937074"/>
      <atom unit="g/mole" value="26.9799858042305"/>
    </material>
    <material name="Steel" state="solid">
      <T unit="K" value="293.15"/>
      <MEE unit="eV" value="282.826129008861"/>
      <D unit="g/cm3" value="8.01999578020493"/>
    </material>    
    <isotope N="14" Z="7" name="N14">
       <atom unit="g/mole" value="14.0031"/>
    </isotope>
    <isotope N="15" Z="7" name="N15">
      <atom unit="g/mole" value="15.0001"/>
    </isotope>
    <element name="Nitrogen">
      <fraction n="0.99632" ref="N14"/>
      <fraction n="0.00368" ref="N15"/>
    </element>
    <isotope N="16" Z="8" name="O16">
      <atom unit="g/mole" value="15.9949"/>
    </isotope>
    <isotope N="17" Z="8" name="O17">
      <atom unit="g/mole" value="16.9991"/>
    </isotope>
    <isotope N="18" Z="8" name="O18">
      <atom unit="g/mole" value="17.9992"/>
    </isotope>
    <element name="Oxygen">
      <fraction n="0.99757" ref="O16"/>
      <fraction n="0.00038" ref="O17"/>
      <fraction n="0.00205" ref="O18"/>
    </element>
    <isotope N="36" Z="18" name="Ar36">
      <atom unit="g/mole" value="35.9675"/>
    </isotope>
    <isotope N="38" Z="18" name="Ar38">
      <atom unit="g/mole" value="37.9627"/>
    </isotope>
    <isotope N="40" Z="18" name="Ar40">
      <atom unit="g/mole" value="39.9624"/>
    </isotope>
    <element name="Argon">
      <fraction n="0.003365" ref="Ar36"/>
      <fraction n="0.000632" ref="Ar38"/>
      <fraction n="0.996003" ref="Ar40"/>
    </element>
    <isotope N="1" Z="1" name="H1">
      <atom unit="g/mole" value="1.00782503081372"/>
    </isotope>
    <isotope N="2" Z="1" name="H2">
      <atom unit="g/mole" value="2.01410199966617"/>
    </isotope>
    <element name="Hidrogen">
      <fraction n="0.999885" ref="H1"/>
      <fraction n="0.000115" ref="H2"/>
    </element>
    <material name="Air" state="gas">
      <T unit="K" value="293.15"/>
      <MEE unit="eV" value="85.5379282211833"/>
      <D unit="g/cm3" value="0.00121399936124299"/>
      <fraction n="0.7494" ref="Nitrogen"/>
      <fraction n="0.2369" ref="Oxygen"/>
      <fraction n="0.0129" ref="Argon"/>
      <fraction n="0.0008" ref="Hidrogen"/>
    </material>
  </materials>

    <solids>
    <polyhedra aunit="deg" deltaphi="360" lunit="mm" name="HRCF" numsides="18" startphi="350">
      <zplane rmax="1866.5" rmin="1775" z="-1158"/>
      <zplane rmax="1866.5" rmin="1775" z="-695.4000000000001"/>
      <zplane rmax="1927.03" rmin="1775" z="-649.7800000000002"/>
      <zplane rmax="2870" rmin="2770.71" z="60.789999999999964"/>
      <zplane rmax="2870" rmin="2813.42" z="91.27000000000044"/>
      <zplane rmax="2870" rmin="2813.42" z="1141"/>
    </polyhedra>
    <polyhedra aunit="deg" deltaphi="20" lunit="mm" name="HEC" numsides="1" startphi="-10">
      <zplane rmax="1866.5" rmin="1775" z="-1158"/>
      <zplane rmax="1866.5" rmin="1775" z="-695.4000000000001"/>
      <zplane rmax="1927.03" rmin="1775" z="-649.7800000000002"/>
      <zplane rmax="2870" rmin="2770.71" z="60.789999999999964"/>
      <zplane rmax="2870" rmin="2813.42" z="91.27000000000044"/>
      <zplane rmax="2870" rmin="2813.42" z="1141"/>
    </polyhedra>
    <polyhedra aunit="deg" deltaphi="360" lunit="mm" name="STEP" numsides="8" startphi="0">
      <zplane rmax="400" rmin="100" z="-300"/>
      <zplane rmax="400" rmin="100" z="0"/>
      <zplane rmax="400" rmin="160" z="0"/>
      <zplane rmax="300" rmin="160" z="300"/>
    </polyhedra>
    <polyhedra aunit="deg" deltaphi="270" lunit="mm" name="OPEN" numsides="6" startphi="45">
      <zplane rmax="400" rmin="100" z="-200"/>
      <zplane rmax="450" rmin="150" z="0"/>
      <zplane rmax="400" rmin="100" z="200"/>
    </polyhedra>
    <box lunit="mm" name="world" x="7000" y="7000" z="3000" />
  </solids>

  <structure>
    <volume name="HEC"><materialref ref="Steel"/><solidref ref="HEC"/></volume>
    <volume name="HRCF">
      <materialref ref="Air"/>
      <solidref ref="HRCF"/>
      <physvol copynumber="1" name="HEC_0">
        <volumeref ref="HEC"/>
        <rotation name="HEC_0_rot" unit="deg" x="0" y="0" z="0"/>
      </physvol>
      <physvol copynumber="2" name="HEC_1">
        <volumeref ref="HEC"/>
        <rotation name="HEC_1_rot" unit="deg" x="0" y="0" z="20"/>
      </physvol>
      <physvol copynumber="3" name="HEC_2">
        <volumeref ref="HEC"/>
        <rotation name="HEC_2_rot" unit="deg" x="0" y="0" z="40"/>
      </physvol>
      <physvol copynumber="4" name="HEC_3">
        <volumeref ref="HEC"/>
        <rotation name="HEC_3_rot" unit="deg" x="0" y="0" z="60"/>
      </physvol>
      <physvol copynumber="5" name="HEC_4">
        <volumeref ref="HEC"/>
        <rotation name="HEC_4_rot" unit="deg" x="0" y="0" z="80"/>
      </physvol>
      <physvol copynumber="6" name="HEC_5">
        <volumeref ref="HEC"/>
        <rotation name="HEC_5_rot" unit="deg" x="0" y="0" z="100"/>
      </physvol>
      <physvol copynumber="7" name="HEC_6">
        <volumeref ref="HEC"/>
        <rotation name="HEC_6_rot" unit="deg" x="0" y="0" z="120"/>
      </physvol>
      <physvol copynumber="8" name="HEC_7">
        <volumeref ref="HEC"/>
        <rotation name="HEC_7_rot" unit="deg" x="0" y="0" z="140"/>
      </physvol>
      <physvol copynumber="9" name="HEC_8">
        <volumeref ref="HEC"/>
        <rotation name="HEC_8_rot" unit="deg" x="0" y="0" z="160"/>
      </physvol>
      <physvol copynumber="10" name="HEC_9">
        <volumeref ref="HEC"/>
        <rotation name="HEC_9_rot" unit="deg" x="0" y="0" z="180"/>
      </physvol>
      <physvol copynumber="11" name="HEC_10">
        <volumeref ref="HEC"/>
        <rotation name="HEC_10_rot" unit="deg" x="0" y="0" z="200"/>
      </physvol>
      <physvol copynumber="12" name="HEC_11">
        <volumeref ref="HEC"/>
        <rotation name="HEC_11_rot" unit="deg" x="0" y="0" z="220"/>
      </physvol>
      <physvol copynumber="13" name="HEC_12">
        <volumeref ref="HEC"/>
        <rotation name="HEC_12_rot" unit="deg" x="0" y="0" z="240"/>
      </physvol>
      <physvol copynumber="14" name="HEC_13">
        <volumeref ref="HEC"/>
        <rotation name="HEC_13_rot" unit="deg" x="0" y="0" z="260"/>
      </physvol>
      <physvol copynumber="15" name="HEC_14">
        <volumeref ref="HEC"/>
        <rotation name="HEC_14_rot" unit="deg" x="0" y="0" z="280"/>
      </physvol>
      <physvol copynumber="16" name="HEC_15">
        <volumeref ref="HEC"/>
        <rotation name="HEC_15_rot" unit="deg" x="0" y="0" z="300"/>
      </physvol>
      <physvol copynumber="17" name="HEC_16">
        <volumeref ref="HEC"/>
        <rotation name="HEC_16_rot" unit="deg" x="0" y="0" z="320"/>
      </physvol>
      <physvol copynumber="18" name="HEC_17">
        <volumeref ref="HEC"/>
        <rotation name="HEC_17_rot" unit="deg" x="0" y="0" z="340"/>
      </physvol>
    </volume>
    <volume name="STEP"><materialref ref="Aluminium"/><solidref ref="STEP"/></volume>
    <volume name="OPEN"><materialref ref="Gold"/><solidref ref="OPEN"/></volume>
    <volume name="world">
      <materialref ref="Vacuum"/>
      <solidref ref="world"/>
      <physvol><volumeref ref="HRCF"/></physvol>
      <physvol>
        <volumeref ref="STEP"/>
        <position name="STEP_pos" unit="mm" x="0" y="0" z="0"/>
      </physvol>
      <physvol>
        <volumeref ref="OPEN"/>
        <position name="OPEN_pos" unit="mm" x="2600" y="2600" z="0"/>
        <rotation name="OPEN_rot" unit="deg" x="30" y="0" z="0"/>
      </physvol>
    </volume>
  </structure>
  <setup name="default" version="1.0">
    <world ref="world"/>
  </setup>

</gdml>
